{
	"name": "@sld/web",
	"private": true,
	"license": "UNLICENSED",
	"version": "0.0.1",
	"type": "module",
	"description": "The sld web app: SvelteKit built as static files with no server.",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest --run",
		"e2e": "playwright test",
		"db:generate": "drizzle-kit generate"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.11",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@electric-sql/pglite": "^0.5.17",
		"@fontsource-variable/hubot-sans": "^5.3.0",
		"@fontsource-variable/mona-sans": "^5.3.0",
		"@fontsource/monaspace-neon": "^5.3.0",
		"drizzle-orm": "^0.45.4",
		"smol-toml": "^1.9.1",
		"yaml": "^2.9.1"
	}
}
